{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [{ "source": "/", "destination": "/glossary/", "permanent": false }],
  "rewrites": [{ "source": "/glossary/:path*", "destination": "/:path*" }]
}

---
import Base from '../layouts/Base.astro';
import { getTerms, categories } from '../lib/terms';
import { layout } from '../lib/graph';

const terms = await getTerms();
const W = 1400, H = 900;
const { nodes, links } = layout(terms, W, H);
const color = Object.fromEntries(categories.map((c) => [c.id, c.color]));
---
<Base title="名詞關係圖｜AI 名詞百科" description="所有名詞之間的關係，一張圖看完。" current="graph">
  <section class="hero" style="padding-bottom:2rem">
    <div class="orb a" aria-hidden="true"></div>
    <div class="wrap" style="display:block">
      <h1 class="rise">名詞之間的<span class="g">關係</span></h1>
      <p class="lede rise" style="--d:1">每個點是一個名詞，每條線是條目裡寫下的一條關係。同一類的名詞聚在同一區；連線越多的點越大。點任何一個名詞，打開它的條目。</p>
      <p class="note"><span class="tnum">{nodes.length}</span> 個名詞 · <span class="tnum">{links.length}</span> 條關係</p>
      <p class="legend" style="justify-content:flex-start">{categories.map((c) => <span style={`--c:${c.color}`}>{c.zh}</span>)}</p>
    </div>
  </section>
  <div class="wrap" style="margin-top:2rem">
    <svg class="graph" viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`名詞關係圖，${nodes.length} 個名詞，${links.length} 條關係`}>
      <g>{links.map((l) => <line class="ln" x1={l.s.x.toFixed(1)} y1={l.s.y.toFixed(1)} x2={l.t.x.toFixed(1)} y2={l.t.y.toFixed(1)} />)}</g>
      <g>{nodes.map((n) => (
        <a href={`/terms/${n.id}`} style={`--c:${color[n.cat]}`}>
          <title>{`${n.label}（${n.zh}）`}</title>
          <circle class="st" cx={n.x.toFixed(1)} cy={n.y.toFixed(1)} r={(3 + Math.sqrt(n.deg) * 1.6).toFixed(1)} />
          <text x={(n.x + 7).toFixed(1)} y={(n.y + 4).toFixed(1)}>{n.label}</text>
        </a>
      ))}</g>
    </svg>
  </div>
  <section class="wrap sec">
    <div class="prose entry">
      <h2>依類別</h2>
      {categories.map((c) => { const list = terms.filter((t) => t.data.category === c.id); return list.length > 0 && (
        <p style={`--c:${c.color}`}><b style="color:var(--c)">{c.zh}</b>　{list.map((t, i) => <>{i > 0 && '、'}<a href={`/terms/${t.id}`}>{t.data.term}</a></>)}</p>
      ); })}
    </div>
  </section>
</Base>
